# Copie este arquivo para ".env" e preencha com sua chave real
# Pegue sua chave gratis em: https://console.groq.com/keys
GROQ_API_KEY=sua_chave_groq_aqui

# Modelo de visao usado na Groq para ler as cores do cubo.
# Se a Groq descontinuar/mudar o modelo, veja a lista atual em:
# https://console.groq.com/docs/vision
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Porta do servidor backend
PORT=3001

# Origem permitida para CORS (URL do frontend). Em producao, troque
# pelo dominio real do frontend publicado.
FRONTEND_ORIGIN=http://localhost:5173
